{
  "expo": {
    "name": "FishDex",
    "slug": "fishdex",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/FishDexAlpha.png",
    "scheme": "fishindex",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fishdex.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "FishDex uses your camera to identify fish species using AI.",
        "NSPhotoLibraryUsageDescription": "FishDex accesses your photo library to identify fish from existing photos.",
        "NSLocationWhenInUseUsageDescription": "FishDex uses your location to improve fish identification accuracy and show your region on the map."
      }
    },
    "android": {
      "versionCode": 1,
      "package": "com.fishdex.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/FishDexAlpha.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#A020F0"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "useProguard": true,
            "useExpoBuildProperties": true,
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}